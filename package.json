{
  "name": "marp-slides",
  "version": "1.0.0",
  "description": "Markdown-based presentation slides with Marp",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run build:html && bun run build:pdf",
    "build:deploy": "bun run build:html && bun run build:pdf && bun run build:pptx && bun run generate:index",
    "preview": "marp -s . --allow-local-files",
    "copy:images": "mkdir -p dist/images && cp -r slides/images/* dist/images/",
    "build:html": "bun run copy:images && marp -I slides/ -o dist/ --html --allow-local-files",
    "build:pdf": "marp -I slides/ -o dist/ --pdf --allow-local-files",
    "build:pptx": "marp -I slides/ -o dist/ --pptx --allow-local-files",
    "generate:index": "node scripts/generate-index.js",
    "lint": "markdownlint slides/**/*.md",
    "lint:fix": "markdownlint --fix slides/**/*.md"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toku345/marp-slides.git"
  },
  "keywords": [
    "marp",
    "presentation",
    "slides",
    "markdown"
  ],
  "author": "toku345",
  "license": "MIT",
  "engines": {
    "bun": "1.3.2"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^3.4.0",
    "markdownlint-cli": "^0.39.0"
  }
}
